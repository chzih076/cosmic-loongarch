new file mode 100644
index 00000000..468012bc
--- /dev/null
+++ b/src/animations.rs
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-3.0
+//
+// cosmic-loongarch 补丁 0001：动画开关与速度倍率的进程内全局。
+//
+// 上游 PR #2209 以“把 bool 穿透到各状态机”的方式实现 enabled；本补丁在此基础上：
+//   * 保留该穿透（enabled 的正确语义：跳过动画而非零时长动画）；
+//   * 追加 `speed` 时长倍率，通过本模块的全局读取，避免再穿透 115 处调用点；
+//   * 为无法方便拿到状态的位置（如全屏过渡闭包）提供 enabled() 查询。
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+use std::time::Duration;
+
+use cosmic_comp_config::AnimationConfig;
+
+static ENABLED: AtomicBool = AtomicBool::new(true);
+static SPEED_MILLI: AtomicU32 = AtomicU32::new(1000); // speed * 1000
+
+/// 应用配置（由 config 模块在加载与配置变更时调用）
+pub fn apply(cfg: &AnimationConfig) {
+    ENABLED.store(cfg.enabled, Ordering::Relaxed);
+    let speed = if cfg.speed.is_finite() { cfg.speed.clamp(0.25, 8.0) } else { 1.0 };
+    SPEED_MILLI.store((speed * 1000.0) as u32, Ordering::Relaxed);
+    tracing::info!(
+        "animations: enabled={} speed={:.2}",
+        cfg.enabled,
+        speed
+    );
+}
+
+/// 动画是否启用
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// 当前速度倍率（1.0 = 上游默认）
+pub fn speed() -> f32 {
+    SPEED_MILLI.load(Ordering::Relaxed) as f32 / 1000.0
+}
+
+/// 按 speed 缩放时长（speed 越大时长越短）
+pub fn scale(base: Duration) -> Duration {
+    let milli = SPEED_MILLI.load(Ordering::Relaxed).max(250);
+    base.mul_f32(1000.0 / milli as f32)
+}
